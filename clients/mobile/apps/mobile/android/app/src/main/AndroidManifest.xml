<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for OAuth/API network calls in all build types. The debug and
         profile manifests also declare this, but those are not merged into
         release builds, so the release app needs it declared here. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required to display push notifications on Android 13+ (API 33+); the
         runtime request happens on the Dart side via
         firebase_messaging's requestPermission() — no extra native code. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Composer voice dictation (speech_to_text). The runtime prompt is
         raised by the plugin on the first dictation. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Chat attachments: camera capture (image_picker). The photo picker on
         API 33+ needs no storage permission; older releases fall back to the
         legacy picker, which image_picker handles without READ_EXTERNAL_STORAGE
         for the picker intent. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Bluetooth headset dictation. Android 12+ uses BLUETOOTH_CONNECT;
         earlier releases use the legacy Bluetooth permissions. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- flutter_web_auth_2 OAuth callback. Debug/profile and Apple builds
             use the brand-driven custom scheme. Play-distributed Android
             releases use one of the verified HTTPS App Links below. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity="">
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${oauthCallbackScheme}" />
            </intent-filter>
            <intent-filter
                android:autoVerify="true"
                android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="app.unstoppable.ai"
                    android:path="/api/mobile/oauth-app-callback" />
            </intent-filter>
            <intent-filter
                android:autoVerify="true"
                android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="code.ud-staging.com"
                    android:path="/api/mobile/oauth-app-callback" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Default notification channel used by firebase_messaging when a
             push payload doesn't specify one. See res/values/strings.xml. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />
        <!-- PostHog is set up from Dart (main.dart) only when a release build
             enables it; never auto-initialize from native code. -->
        <meta-data
            android:name="com.posthog.posthog.AUTO_INIT"
            android:value="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- url_launcher: transcript links open externally. Both http and
             https are declared because the transcript link policy (web
             parity) treats both as navigable. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <!-- speech_to_text: Android 11+ package visibility for the system
             speech recognizer; without it initialize() reports unavailable. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- image_picker: Android 11+ package visibility for the camera capture intent. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
</manifest>
