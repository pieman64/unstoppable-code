   "source": [
    "# Growth analysis\n",
    "\n",
    "Each quarter grows as $x^2$, so the total is $$\\sum_{k=1}^{n} k^2 = \\frac{n(n+1)(2n+1)}{6}$$\n"
   ]
  },
  {
   "cell_type": "code",
   "id": "compute",
   "execution_count": 1,
   "metadata": {},
   "source": [
    "quarters = [1, 2, 3]\n",
    "totals = [q ** 2 for q in quarters]\n",
    "print(\"Quarterly totals:\", totals)"
   ],
   "outputs": [
    {
     "output_type": "stream",
     "name": "stdout",
     "text": [
      "Quarterly totals: [1, 4, 9]\n"
     ]
    }
   ]
  },
