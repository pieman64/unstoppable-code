{
  "cowork": {
    "activity": {
      "name": "Cowork digest",
      "action": {
        "type": "standalone_prompt",
        "chatProjectId": "automation-cowork",
        "prompt": "[Canopy-CCONVCOWORK] Summarize the notes.",
        "model": "gpt-6-sol"
      }
    },
    "pipeline": {
      "name": "Cowork digest",
      "scope": "global",
      "on": {
        "dispatch": {
          "inputs": {
            "project_id": {
              "required": false
            }
          }
        }
      },
      "jobs": {
        "chat": {
          "steps": [
            {
              "id": "entry",
              "uses": "builtin/create-project-entry",
              "with": {
                "project_id": "${{ inputs.project_id }}"
              }
            },
            {
              "id": "send",
              "uses": "builtin/send-agent-message",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ steps.entry.outputs.task_id }}",
                "text": "[Canopy-CCONVCOWORK] Summarize the notes.",
                "literal_text": "true",
                "model": "gpt-6-sol",
                "replace_empty_chat": "true"
              }
            },
            {
              "id": "reply",
              "uses": "builtin/wait-for-agent-reply",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ steps.entry.outputs.task_id }}",
                "chat_id": "${{ steps.send.outputs.chat_id }}",
                "message_id": "${{ steps.send.outputs.message_id }}",
                "reply_timeout_minutes": "720"
              }
            }
          ]
        }
      }
    },
    "inputs": {
      "project_id": "automation-cowork"
    }
  },
  "orchestrator": {
    "activity": {
      "name": "Orchestrator check",
      "action": {
        "type": "app_advisor_prompt",
        "prompt": "[Canopy-CCONVADVISOR] List the settings that changed.",
        "model": "gpt-6-sol"
      }
    },
    "pipeline": {
      "name": "Orchestrator check",
      "scope": "global",
      "on": {
        "dispatch": {
          "inputs": {
            "bot_id": {
              "required": false
            }
          }
        }
      },
      "jobs": {
        "chat": {
          "steps": [
            {
              "id": "entry",
              "uses": "builtin/create-bot-entry",
              "with": {
                "bot_id": "${{ inputs.bot_id }}",
                "title": "Orchestrator check"
              }
            },
            {
              "id": "send",
              "uses": "builtin/send-agent-message",
              "with": {
                "bot_id": "${{ inputs.bot_id }}",
                "task_id": "${{ steps.entry.outputs.task_id }}",
                "text": "[Canopy-CCONVADVISOR] List the settings that changed.",
                "literal_text": "true",
                "model": "gpt-6-sol",
                "replace_empty_chat": "true"
              }
            }
          ]
        }
      }
    },
    "inputs": {
      "bot_id": "app_advisor"
    }
  },
  "session": {
    "activity": {
      "name": "Session follow-up",
      "action": {
        "type": "worktree_session_prompt",
        "workspaceId": "demo-ts-pnpm-vite",
        "worktreeId": "demo-main",
        "chatId": "session-chat",
        "prompt": "[Canopy-CCONVSESSION] Continue the review."
      }
    },
    "pipeline": {
      "name": "Session follow-up",
      "scope": "global",
      "on": {
        "dispatch": {
          "inputs": {
            "project_id": {
              "required": false
            },
            "task_id": {
              "required": false
            },
            "chat_id": {
              "required": false
            }
          }
        }
      },
      "jobs": {
        "chat": {
          "steps": [
            {
              "id": "send",
              "uses": "builtin/send-agent-message",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ inputs.task_id }}",
                "chat_id": "${{ inputs.chat_id }}",
                "text": "[Canopy-CCONVSESSION] Continue the review.",
                "literal_text": "true"
              }
            },
            {
              "id": "reply",
              "uses": "builtin/wait-for-agent-reply",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ inputs.task_id }}",
                "chat_id": "${{ inputs.chat_id }}",
                "message_id": "${{ steps.send.outputs.message_id }}",
                "reply_timeout_minutes": "720"
              }
            }
          ]
        }
      }
    },
    "inputs": {
      "project_id": "demo-ts-pnpm-vite",
      "task_id": "demo-main",
      "chat_id": "session-chat"
    }
  },
  "worktree": {
    "activity": {
      "name": "Worktree review",
      "action": {
        "type": "worktree_prompt",
        "workspaceId": "demo-ts-pnpm-vite",
        "baseWorktreeId": "demo-main",
        "prompt": "[Canopy-CCONVWORKTREE] Review the latest changes.",
        "model": "gpt-6-sol"
      }
    },
    "pipeline": {
      "name": "Worktree review",
      "scope": "global",
      "on": {
        "dispatch": {
          "inputs": {
            "project_id": {
              "required": false
            },
            "base_task_id": {
              "required": false
            }
          }
        }
      },
      "jobs": {
        "chat": {
          "steps": [
            {
              "id": "worktree",
              "uses": "builtin/create-worktree",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "base_task_id": "${{ inputs.base_task_id }}",
                "worktree_setup": "run"
              }
            },
            {
              "id": "send",
              "uses": "builtin/send-agent-message",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ steps.worktree.outputs.task_id }}",
                "text": "[Canopy-CCONVWORKTREE] Review the latest changes.",
                "literal_text": "true",
                "model": "gpt-6-sol",
                "replace_empty_chat": "true"
              }
            },
            {
              "id": "reply",
              "uses": "builtin/wait-for-agent-reply",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ steps.worktree.outputs.task_id }}",
                "chat_id": "${{ steps.send.outputs.chat_id }}",
                "message_id": "${{ steps.send.outputs.message_id }}",
                "reply_timeout_minutes": "720"
              }
            }
          ]
        }
      }
    },
    "inputs": {
      "project_id": "demo-ts-pnpm-vite",
      "base_task_id": "demo-main"
    }
  }
}
