      "task_id": "demo-main",
      "chat_id": "session-chat"
    }
  },
  "session_composer": {
    "activity": {
      "name": "Session follow-up with an attachment",
      "action": {
        "type": "worktree_session_prompt",
        "workspaceId": "demo-ts-pnpm-vite",
        "worktreeId": "demo-main",
        "chatId": "session-chat",
        "prompt": "[Canopy-CCONVSESSIONVOICE] Continue the review.",
        "attachmentPaths": ["/automation-attachments/demo-main/notes.txt"],
        "inputMode": "voice"
      }
    },
    "pipeline": {
      "name": "Session follow-up with an attachment",
      "scope": "global",
      "on": {
        "dispatch": {
          "inputs": {
            "project_id": {
              "required": false
            },
            "task_id": {
              "required": false
            },
            "chat_id": {
              "required": false
            },
            "attachment_paths": {
              "required": false
            },
            "input_mode": {
              "required": false
            }
          }
        }
      },
      "jobs": {
        "chat": {
          "steps": [
            {
              "id": "send",
              "uses": "builtin/send-agent-message",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ inputs.task_id }}",
                "chat_id": "${{ inputs.chat_id }}",
                "text": "[Canopy-CCONVSESSIONVOICE] Continue the review.",
                "literal_text": "true",
                "attachment_paths": "${{ inputs.attachment_paths }}",
                "input_mode": "${{ inputs.input_mode }}"
              }
            },
            {
              "id": "reply",
              "uses": "builtin/wait-for-agent-reply",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ inputs.task_id }}",
                "chat_id": "${{ inputs.chat_id }}",
                "message_id": "${{ steps.send.outputs.message_id }}",
                "reply_timeout_minutes": "720"
              }
            }
          ]
        }
      }
    },
    "inputs": {
      "project_id": "demo-ts-pnpm-vite",
      "task_id": "demo-main",
      "chat_id": "session-chat",
      "attachment_paths": "[\"/automation-attachments/demo-main/notes.txt\"]",
      "input_mode": "voice"
    }
  },
  "worktree": {
    "activity": {
      "name": "Worktree review",
      "action": {
        "type": "worktree_prompt",
        "workspaceId": "demo-ts-pnpm-vite",
        "baseWorktreeId": "demo-main",
        "prompt": "[Canopy-CCONVWORKTREE] Review the latest changes.",
        "model": "gpt-6-sol"
      }
    },
    "pipeline": {
      "name": "Worktree review",
      "scope": "global",
      "on": {
        "dispatch": {
          "inputs": {
            "project_id": {
              "required": false
            },
            "base_task_id": {
              "required": false
            }
          }
        }
      },
      "jobs": {
        "chat": {
          "steps": [
            {
              "id": "worktree",
              "uses": "builtin/create-worktree",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "base_task_id": "${{ inputs.base_task_id }}",
                "worktree_setup": "run"
              }
            },
            {
              "id": "send",
              "uses": "builtin/send-agent-message",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ steps.worktree.outputs.task_id }}",
                "text": "[Canopy-CCONVWORKTREE] Review the latest changes.",
                "literal_text": "true",
                "model": "gpt-6-sol",
                "replace_empty_chat": "true"
              }
            },
            {
              "id": "reply",
              "uses": "builtin/wait-for-agent-reply",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ steps.worktree.outputs.task_id }}",
                "chat_id": "${{ steps.send.outputs.chat_id }}",
                "message_id": "${{ steps.send.outputs.message_id }}",
                "reply_timeout_minutes": "720"
              }
            }
          ]
        }
      }
    },
    "inputs": {
      "project_id": "demo-ts-pnpm-vite",
      "base_task_id": "demo-main"
    }
  },
  "worktree_agent": {
    "activity": {
      "name": "Worktree review by an Agent",
      "action": {
        "type": "worktree_prompt",
        "workspaceId": "demo-ts-pnpm-vite",
        "baseWorktreeId": "demo-main",
        "prompt": "[Canopy-CCONVWORKTREEAGENT] Review the latest changes.",
        "model": "agent_model_automation_reviewer"
      }
    },
    "pipeline": {
      "name": "Worktree review by an Agent",
      "scope": "global",
      "on": {
        "dispatch": {
          "inputs": {
            "project_id": {
              "required": false
            },
            "base_task_id": {
              "required": false
            }
          }
        }
      },
      "model_aliases": [
        {
          "id": "chat_model",
          "name": "Chat agent"
        }
      ],
      "jobs": {
        "chat": {
          "steps": [
            {
              "id": "worktree",
              "uses": "builtin/create-worktree",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "base_task_id": "${{ inputs.base_task_id }}",
                "worktree_setup": "run"
              }
            },
            {
              "id": "send",
              "uses": "builtin/send-agent-message",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ steps.worktree.outputs.task_id }}",
                "text": "[Canopy-CCONVWORKTREEAGENT] Review the latest changes.",
                "literal_text": "true",
                "model": "chat_model",
                "replace_empty_chat": "true"
              }
            },
            {
              "id": "reply",
              "uses": "builtin/wait-for-agent-reply",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ steps.worktree.outputs.task_id }}",
                "chat_id": "${{ steps.send.outputs.chat_id }}",
                "message_id": "${{ steps.send.outputs.message_id }}",
                "reply_timeout_minutes": "720"
              }
            }
          ]
        }
      }
    },
    "inputs": {
      "project_id": "demo-ts-pnpm-vite",
      "base_task_id": "demo-main"
    },
    "modelAliasPreferences": {
      "chat_model": {
        "mode": "agent",
        "agent_id": "agent_model_automation_reviewer"
      }
    }
  }
}
