        "worktreeId": "demo-main",
        "chatId": "session-chat",
        "prompt": "[Canopy-CCONVSESSION] Continue the review."
      }
    },
    "pipeline": {
      "name": "Session follow-up",
      "scope": "global",
      "on": {
        "dispatch": {
          "inputs": {
            "project_id": {
              "required": false
            },
            "task_id": {
              "required": false
            },
            "chat_id": {
              "required": false
            }
          }
        }
      },
      "jobs": {
        "chat": {
          "steps": [
            {
              "id": "send",
              "uses": "builtin/send-agent-message",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ inputs.task_id }}",
                "chat_id": "${{ inputs.chat_id }}",
                "text": "[Canopy-CCONVSESSION] Continue the review.",
                "literal_text": "true"
              }
            },
            {
              "id": "reply",
              "uses": "builtin/wait-for-agent-reply",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ inputs.task_id }}",
                "chat_id": "${{ inputs.chat_id }}",
                "message_id": "${{ steps.send.outputs.message_id }}",
