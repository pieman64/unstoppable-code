{
  "cowork": {
    "activity": {
      "name": "Cowork digest",
      "action": {
        "type": "standalone_prompt",
        "chatProjectId": "automation-cowork",
        "prompt": "[Canopy-CCONVCOWORK] Summarize the notes.",
        "model": "gpt-6-sol"
      }
    },
    "pipeline": {
      "name": "Cowork digest",
      "scope": "global",
      "on": {
        "dispatch": {
          "inputs": {
            "project_id": {
              "required": false
            }
          }
        }
      },
      "jobs": {
        "chat": {
          "steps": [
            {
              "id": "entry",
              "uses": "builtin/create-project-entry",
              "with": {
                "project_id": "${{ inputs.project_id }}"
              }
            },
            {
              "id": "send",
              "uses": "builtin/send-agent-message",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ steps.entry.outputs.task_id }}",
                "text": "[Canopy-CCONVCOWORK] Summarize the notes.",
                "literal_text": "true",
                "model": "gpt-6-sol",
                "replace_empty_chat": "true"
              }
            },
            {
              "id": "reply",
              "uses": "builtin/wait-for-agent-reply",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ steps.entry.outputs.task_id }}",
                "chat_id": "${{ steps.send.outputs.chat_id }}",
                "message_id": "${{ steps.send.outputs.message_id }}",
                "reply_timeout_minutes": "720"
              }
            }
          ]
        }
      }
    },
    "inputs": {
      "project_id": "automation-cowork"
    }
  },
  "cowork_selections": {
    "activity": {
      "name": "Cowork digest with plugins",
      "action": {
        "type": "standalone_prompt",
        "chatProjectId": "automation-cowork",
        "prompt": "[Canopy-CCONVCOWORKPLUGINS] Summarize the notes.",
        "model": "gpt-6-sol",
        "modelConfig": {
          "speed": "ultrafast",
          "fastMode": false
        },
        "pluginSelections": {
          "collectionIds": ["automation-collection"],
          "skillRefs": [],
          "pluginRefs": []
        }
      }
    },
    "pipeline": {
      "name": "Cowork digest with plugins",
      "scope": "global",
      "on": {
        "dispatch": {
          "inputs": {
            "project_id": {
              "required": false
            },
            "plugin_selections": {
              "required": false
            }
          }
        }
      },
      "jobs": {
        "chat": {
          "steps": [
            {
              "id": "entry",
              "uses": "builtin/create-project-entry",
              "with": {
                "project_id": "${{ inputs.project_id }}"
              }
            },
            {
              "id": "send",
              "uses": "builtin/send-agent-message",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ steps.entry.outputs.task_id }}",
                "text": "[Canopy-CCONVCOWORKPLUGINS] Summarize the notes.",
                "literal_text": "true",
                "model": "gpt-6-sol",
                "speed": "ultrafast",
                "plugin_selections": "${{ inputs.plugin_selections }}",
                "replace_empty_chat": "true"
              }
            },
            {
              "id": "reply",
              "uses": "builtin/wait-for-agent-reply",
              "with": {
                "project_id": "${{ inputs.project_id }}",
                "task_id": "${{ steps.entry.outputs.task_id }}",
                "chat_id": "${{ steps.send.outputs.chat_id }}",
                "message_id": "${{ steps.send.outputs.message_id }}",
                "reply_timeout_minutes": "720"
              }
            }
          ]
        }
      }
    },
    "inputs": {
      "project_id": "automation-cowork",
      "plugin_selections": "{\"collectionIds\":[\"automation-collection\"],\"skillRefs\":[],\"pluginRefs\":[]}"
    }
  },
  "orchestrator": {
    "activity": {
      "name": "Orchestrator check",
      "action": {
        "type": "app_advisor_prompt",
        "prompt": "[Canopy-CCONVADVISOR] List the settings that changed.",
        "model": "gpt-6-sol"
      }
    },
    "pipeline": {
      "name": "Orchestrator check",
      "scope": "global",
      "on": {
        "dispatch": {
          "inputs": {
            "bot_id": {
              "required": false
            }
          }
        }
      },
      "jobs": {
        "chat": {
          "steps": [
            {
              "id": "entry",
              "uses": "builtin/create-bot-entry",
              "with": {
                "bot_id": "${{ inputs.bot_id }}",
                "title": "Orchestrator check"
              }
            },
            {
              "id": "send",
              "uses": "builtin/send-agent-message",
              "with": {
                "bot_id": "${{ inputs.bot_id }}",
                "task_id": "${{ steps.entry.outputs.task_id }}",
                "text": "[Canopy-CCONVADVISOR] List the settings that changed.",
                "literal_text": "true",
                "model": "gpt-6-sol",
                "replace_empty_chat": "true"
              }
            }
          ]
        }
      }
    },
    "inputs": {
      "bot_id": "app_advisor"
    }
  },
  "orchestrator_expressions": {
    "activity": {
      "name": "Orchestrator ${{ inputs.check }}",
      "action": {
        "type": "app_advisor_prompt",
        "sidebarGroupName": "None",
        "prompt": "[Canopy-CCONVADVISOREXPR] List the settings that changed.",
        "model": "gpt-6-sol"
      }
    },
    "pipeline": {
      "name": "Orchestrator ${{ inputs.check }}",
      "scope": "global",
      "on": {
        "dispatch": {
          "inputs": {
            "bot_id": {
              "required": false
            }
          }
        }
      },
      "jobs": {
        "chat": {
          "steps": [
            {
              "id": "entry",
              "uses": "builtin/create-bot-entry",
              "with": {
                "bot_id": "${{ inputs.bot_id }}",
                "title": "Orchestrator ${{ '${{' }} inputs.check }}",
                "group": "None"
              }
            },
            {
              "id": "send",
              "uses": "builtin/send-agent-message",
              "with": {
                "bot_id": "${{ inputs.bot_id }}",
                "task_id": "${{ steps.entry.outputs.task_id }}",
                "text": "[Canopy-CCONVADVISOREXPR] List the settings that changed.",
                "literal_text": "true",
                "model": "gpt-6-sol",
                "replace_empty_chat": "true"
              }
            }
          ]
        }
      }
    },
    "inputs": {
      "bot_id": "app_advisor"
    }
  },
  "session": {
