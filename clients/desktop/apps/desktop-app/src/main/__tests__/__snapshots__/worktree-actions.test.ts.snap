exports[`searchWorktreeActions ranking characterization scopes the sidebar.item_groups.set_item catalog entry for { executionScope: 'directory' } 2`] = `
{
  "category": "sidebar",
  "example": {
    "newGroup": {
      "color": "categorical-2",
      "name": "Tasks",
    },
    "type": "sidebar.item_groups.set_item",
  },
  "fields": [
    {
      "description": "Existing group id; null ungroups this item only. Supply groupId or newGroup.",
      "name": "groupId",
      "required": false,
      "type": "string | null",
    },
    {
      "description": "Create a group and assign the item atomically. Mutually exclusive with groupId. name is trimmed and limited to 80 Unicode code points; an omitted or blank name stores the default name \`Group <n>\` with its label hidden. labelHidden hides a named label; names in the default \`Group <n>\` format are always hidden.",
      "name": "newGroup",
      "required": false,
      "type": "{name?:string,color?:SidebarItemGroupColor,labelHidden?:boolean}",
    },
  ],
  "notes": [
    "Pinned, hidden and branch-stack child items cannot be independently grouped. groupId:null preserves other members; the empty group is removed when its last member leaves.",
    "Do not provide projectId or worktreeId; this cowork project chat supplies its project scope server-side.",
    "Do not supply scope or itemId. The current project and sidebar item are supplied by this chat; groupId:null ungroups only the current item.",
  ],
  "optionalFields": [
    "groupId",
    "newGroup",
  ],
  "requiredFields": [],
  "summary": "Set an item’s sidebar group, create a new group inline, or remove its membership. Current cowork project scope is applied by Canopy.",
  "type": "sidebar.item_groups.set_item",
}
`;

