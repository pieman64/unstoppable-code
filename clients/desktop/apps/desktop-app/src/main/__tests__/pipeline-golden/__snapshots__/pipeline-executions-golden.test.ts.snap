      "result": {
        "executionId": "<uuid>",
      },
    },
    "updates": [],
  },
  "retryMissing": {
    "event": "portal.command.failed",
    "payload": {
      "error": {
        "code": "not_found",
        "message": "Workflow execution not found.",
      },
      "generatedAt": "<timestamp>",
      "retryable": false,
    },
    "updates": [],
  },
  "ultraFast": {
    "event": "portal.command.failed",
    "payload": {
      "error": {
        "code": "invalid_payload",
        "message": "modelConfig.speed must be standard, fast, or ultrafast.",
      },
      "generatedAt": "<timestamp>",
      "retryable": false,
    },
    "updates": [],
  },
  "undeclaredInput": {
    "event": "portal.command.failed",
    "payload": {
      "error": {
        "code": "execution_failed",
        "message": "Workflow input validation failed:
- Workflow input "unknown" is not declared",
      },
      "generatedAt": "<timestamp>",
      "retryable": false,
    },
    "updates": [],
  },
  "unknownWorktree": {
    "event": "portal.command.failed",
    "payload": {
      "error": {
        "code": "execution_failed",
        "message": "Workflow unavailable (unsupported-target)",
      },
      "generatedAt": "<timestamp>",
      "retryable": false,
    },
    "updates": [],
  },
  "unsupportedEvent": {
    "event": "portal.command.failed",
