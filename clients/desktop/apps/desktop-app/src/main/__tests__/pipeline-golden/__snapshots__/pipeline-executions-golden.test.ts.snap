        "code": "not_found",
        "message": "Workflow execution not found.",
      },
      "generatedAt": "<timestamp>",
      "retryable": false,
    },
    "updates": [],
  },
  "invalidLocator": {
    "event": "portal.command.failed",
    "payload": {
      "error": {
        "code": "invalid_payload",
        "message": "Invalid pipelineId: must be lowercase alphanumeric with hyphens",
      },
      "generatedAt": "<timestamp>",
      "retryable": false,
    },
    "updates": [],
  },
  "missingPipeline": {
    "event": "portal.command.failed",
    "payload": {
      "error": {
        "code": "not_found",
        "message": "Workflow not found.",
      },
      "generatedAt": "<timestamp>",
      "retryable": false,
    },
    "updates": [],
  },
  "missingTarget": {
    "event": "portal.command.completed",
