{
  "version": 1,
  "scripts": {
    "setup": "pnpm install",
    "test": {
      "command": "pnpm test",
      "timeoutSeconds": 900,
      "shell": {
        "windows": "powershell",
        "mac": "zsh"
      }
    }
  },
  "hooks": {
    "pr:create": [
      {
        "type": "command",
        "command": "echo hook",
        "shell": {
          "windows": "cmd",
          "mac": "bash"
        }
      }
    ]
  },
  "repos": [
    {
      "id": "web",
      "name": "Web",
      "url": "https://example.com/web.git",
      "scripts": {
        "launch": {
          "command": "pnpm run dev",
          "shell": {
            "windows": "bash",
            "mac": "bash"
          }
        }
      }
    }
  ]
}
