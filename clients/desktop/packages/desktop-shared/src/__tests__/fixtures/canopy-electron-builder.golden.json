{
  "appId": "com.canopy.ui",
  "productName": "Canopy",
  "beforeBuild": "./scripts/beforeBuild.js",
  "beforePack": "./scripts/beforePack.js",
  "afterPack": "./scripts/afterPack.js",
  "asar": true,
  "electronFuses": {
    "runAsNode": true,
    "enableCookieEncryption": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "resetAdHocDarwinSignature": true
  },
  "publish": {
    "provider": "generic",
    "channel": "latest",
    "url": "https://releases.unstoppable.ai/desktop/canopy"
  },
  "directories": {
    "output": "dist",
    "buildResources": "<repo>/.cache/brand/canopy/electron-resources"
  },
  "files": [
    "out/**/*",
    "!**/*.map",
    "package.json",
    "!**/node_modules/@github/copilot-sdk-*{,/**}"
  ],
  "asarUnpack": [
    "**/node_modules/node-pty/**",
    "!**/node_modules/node-pty/**/*.map",
    "**/node_modules/koffi/build/koffi/linux_x64/koffi.node"
  ],
  "extraResources": [
    {
      "from": "<repo>/.cache/brand/canopy/electron-resources/icon.icns",
      "to": "icon.icns"
    },
    {
      "from": "<repo>/.cache/brand/canopy/electron-resources/icon.png",
      "to": "icon.png"
    },
    {
      "from": "<repo>/.cache/brand/canopy/electron-resources/icon.ico",
      "to": "icon.ico"
    },
    {
      "from": "dist/legal/THIRD_PARTY_NOTICES.txt",
      "to": "THIRD_PARTY_NOTICES.txt"
    },
    {
      "from": "<repo>/.cache/brand/canopy/resources/pipelines",
      "to": "pipelines",
      "filter": ["**/*.yaml", "index.json"]
    },
    {
      "from": "<repo>/.cache/brand/canopy/resources/actions",
      "to": "actions",
      "filter": ["**/*", "!**/*.map"]
    },
    {
      "from": "<repo>/.cache/brand/canopy/resources/skills",
      "to": "skills",
      "filter": ["**/SKILL.md"]
    },
    {
      "from": "packages/desktop-shared/resources/code-graph",
      "to": "code-graph",
      "filter": ["**/*"]
    },
    {
      "from": "<repo>/.cache/brand/canopy/resources/plugins",
      "to": "plugins"
    }
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "icon": "<repo>/.cache/brand/canopy/electron-resources/icon.icns",
    "entitlements": "<repo>/apps/desktop-app/resources/entitlements.mac.plist",
    "entitlementsInherit": "<repo>/apps/desktop-app/resources/entitlements.mac.plist",
    "notarize": true,
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Canopy uses your microphone for voice dictation in the chat composer.",
      "NSSpeechRecognitionUsageDescription": "Canopy uses speech recognition to transcribe your voice into chat messages.",
      "NSHumanReadableCopyright": "Copyright © <year> Canopy Team"
    },
    "extraResources": [
      {
        "from": ".cache/bin/darwin-${arch}",
        "to": "bin",
        "filter": [
          "**/*",
          "!ollama",
          "!ollama.exe",
          "!ollama-bin/**",
          "!.ollama-version",
          "!.ollama-files.json"
        ]
      },
      {
        "from": ".cache/cli/darwin-${arch}",
        "to": "cli",
        "filter": ["**/*"]
      }
    ],
    "target": ["dmg", "zip"],
    "protocols": [
      {
        "name": "Canopy web links",
        "schemes": ["http", "https"],
        "role": "Viewer"
      }
    ]
  },
  "win": {
    "icon": "<repo>/.cache/brand/canopy/electron-resources/icon-full.ico",
    "files": [
      "out/**/*",
      "!**/*.map",
      "!**/node_modules/node-pty/prebuilds/!(win32-${arch}){,/**}"
    ],
    "extraResources": [
      {
        "from": "<repo>/.cache/brand/canopy/electron-resources/icon-full.ico",
        "to": "icon-full.ico"
      },
      {
        "from": ".cache/bin/win32-${arch}",
        "to": "bin",
        "filter": [
          "**/*",
          "!ollama",
          "!ollama.exe",
          "!ollama-bin/**",
          "!.ollama-version",
          "!.ollama-files.json",
          "!canopy-dictate",
          "!canopy-dictate.exe",
          "!.canopy-dictate-version"
        ]
      },
      {
        "from": ".cache/cli/win32-${arch}",
        "to": "cli",
        "filter": ["**/*"]
      }
    ],
    "target": ["nsis", "zip"]
  },
  "linux": {
    "icon": "<repo>/.cache/brand/canopy/electron-resources/icons",
    "extraResources": [
      {
        "from": ".cache/bin/linux-${arch}",
        "to": "bin",
        "filter": [
          "**/*",
          "!ollama",
          "!ollama.exe",
          "!ollama-bin/**",
          "!.ollama-version",
          "!.ollama-files.json",
          "!canopy-dictate",
          "!canopy-dictate.exe",
          "!.canopy-dictate-version"
        ]
      },
      {
        "from": ".cache/cli/linux-${arch}",
        "to": "cli",
        "filter": ["**/*"]
      }
    ],
    "target": [
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Development",
    "files": [
      "out/**/*",
      "!**/*.map",
      "package.json",
      "!**/node_modules/@github/copilot-sdk-*{,/**}",
      "!**/node_modules/node-pty/prebuilds{,/**}",
      "!**/node_modules/node-pty/bin{,/**}",
      "!**/node_modules/node-pty/third_party{,/**}",
      "!**/node_modules/node-pty/build/Debug{,/**}",
      "!**/node_modules/node-pty/build/Release/obj.target{,/**}",
      "!**/node_modules/node-pty/build/Release/spawn-helper",
      "!**/node_modules/@koromix/koffi-*{,/**}",
      "!**/node_modules/koffi/build/!(koffi){,/**}",
      "!**/node_modules/koffi/build/koffi/!(linux_x64){,/**}",
      "!**/node_modules/koffi/build/koffi/linux_x64/!(koffi.node){,/**}",
      "!**/node_modules/fsevents{,/**}",
      "!**/node_modules/node-pty/build/!(Release){,/**}",
      "!**/node_modules/node-pty/build/Release/!(pty.node){,/**}",
      "!node_modules/react-diff-viewer-continued/playwright-report{,/**/*}",
      "!node_modules/react-diff-viewer-continued/test-results{,/**/*}",
      "!node_modules/@reduxjs/toolkit/src/entities/tests/fixtures{,/**/*}"
    ],
    "executableName": "canopy-desktop",
    "description": "Canopy - Autonomous multi-agent orchestration framework",
    "synopsis": "Canopy - Autonomous multi-agent orchestration framework",
    "syncDesktopName": true,
    "executableArgs": [],
    "desktop": {
      "entry": {
        "Name": "Canopy",
        "Type": "Application",
        "Terminal": "false",
        "Icon": "canopy-desktop",
        "StartupWMClass": "canopy-desktop"
      }
    },
    "maintainer": "Canopy Team <support@unstoppabledomains.com>"
  },
  "deb": {
    "packageCategory": "devel",
    "depends": [
      "libgtk-3-0t64",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0t64",
      "libuuid1",
      "libsecret-1-0",
      "libasound2t64",
      "libgbm1",
      "libatk-bridge2.0-0t64",
      "git"
    ],
    "recommends": ["libappindicator3-1"],
    "packageName": "canopy-desktop"
  },
  "extraMetadata": {
    "name": "canopy",
    "productName": "Canopy",
    "description": "Canopy - Autonomous multi-agent orchestration framework",
    "author": "Canopy Team",
    "desktopName": "canopy-desktop.desktop"
  },
  "artifactName": "canopy-${version}-${os}-${arch}.${ext}",
  "protocols": [
    {
      "name": "Canopy deep links",
      "schemes": ["canopy"],
      "role": "Viewer"
    }
  ],
  "nsis": {
    "include": "apps/desktop-app/resources/installer.nsh"
  }
}
