    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/**/__scratch__/**"
  ],
  "references": [
    {
      "path": "../code-graph"
    },
    {
      "path": "../execution-engine"
    },
    {
      "path": "../core-platform"
    },
    {
      "path": "../core-runtime"
    },
    {
      "path": "../protocol"
    },
    {
      "path": "../plugin-interop"
    },
    {
      "path": "../agent-actions"
    },
    {
      "path": "../agent-transcript"
    },
    {
      "path": "../pipeline-interop"
    },
    {
      "path": "../copilot-recipient"
    }
  ]
}
