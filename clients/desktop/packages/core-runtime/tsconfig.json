{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "out",
    "rootDir": "src",
    "types": ["node"]
  },
  "references": [
    { "path": "../core-transport" },
    { "path": "../pipeline-interop" },
    { "path": "../protocol" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "src/**/__scratch__/**"
  ]
}
