{
  "name": "@canopy/agent-transcript",
  "version": "0.0.0",
  "private": true,
  "description": "Browser-safe, protocol-only agent transcript types, JSONL parser, and Portal chat projection shared by the desktop app and the hosted web run viewer. No Node/Electron/Prisma/Next imports.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./portal": "./src/portal/persisted-chat-projection.ts",
    "./turn": "./src/turn/index.ts",
    "./*": "./src/*",
    "./lib/command-read-display": "./src/lib/command-read-display.ts",
    "./lib/plan-tool-input": "./src/lib/plan-tool-input.ts",
    "./lib/delegation-card-state": "./src/lib/delegation-card-state.ts",
    "./lib/visual-ref": "./src/lib/visual-ref.ts"
  },
  "dependencies": {
    "@canopy/protocol": "workspace:*"
  }
}
